<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Apache serve actual files (like API scripts, images, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite all other requests to index.html to allow React Router to handle it
  RewriteRule ^ index.html [L]

  # Block access to .env files for security
  <Files ".env">
    Require all denied
  </Files>
</IfModule>
